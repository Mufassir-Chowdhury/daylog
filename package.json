{
	"name": "todo",
	"productName": "daylog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "One text file per day — web app and always-on desktop assistant.",
	"main": "desktop/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"desktop": "vite build --mode desktop && electron .",
		"desktop:dev": "electron . --dev",
		"desktop:build": "vite build --mode desktop",
		"desktop:dist": "vite build --mode desktop && electron-builder --win",
		"desktop:icons": "node desktop/make-icons.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"firebase": "^12.16.0"
	},
	"build": {
		"appId": "app.daylog.desktop",
		"productName": "daylog",
		"directories": {
			"output": "desktop/dist",
			"buildResources": "desktop/icons"
		},
		"files": [
			"package.json",
			"desktop/main.cjs",
			"desktop/activity.cjs",
			"desktop/preload.cjs",
			"desktop/app/**",
			"desktop/icons/**",
			"!node_modules/**"
		],
		"win": {
			"target": [
				"nsis"
			],
			"icon": "desktop/icons/icon.png"
		},
		"nsis": {
			"artifactName": "daylog-setup.${ext}",
			"oneClick": true,
			"perMachine": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"runAfterFinish": true
		}
	}
}
